{
  "name": "service-desk-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && node tools/check-architecture.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -p tests/contracts/tsconfig.json",
